{
  "explorer.icon.enableNerdfont": true,
  "explorer.icon.source": "nerdfont.vim",
  "languageserver": {
    "efm": {
      "command": "efm-langserver",
      "filetypes": ["vim", "eruby", "markdown", "yaml", "lua"],
      "rootPatterns": [".git", "vimrc", "init.vim", "selene.toml"]
    },
    "gopls": {
      "command": "gopls",
      "filetypes": ["go"],
      "rootPatterns": ["go.mod"]
    }
  },
  "ltex.disabledRules": {
    "en-US": ["MORFOLOGIK_RULE_EN_US"]
  },
  "prettier.documentSelectors": ["**/*.qmd"]
}
