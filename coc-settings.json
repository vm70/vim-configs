{
  "[json]": {
    "coc.preferences.formatterExtension": "coc-prettier"
  },
  "[latex][tex]": {
    "inlayHint.enable": false
  },
  "[lua]": {
    "coc.preferences.formatterExtension": "languageserver.stylua"
  },
  "[python]": {
    "coc.preferences.formatterExtension": "languageserver.ruff"
  },
  "coc.preferences.formatOnSave": false,
  "coc.preferences.formatOnSaveTimeout": 2000,
  "json.format.enable": false,
  "languageserver": {
    "clangd": {
      "command": "clangd",
      "enable": false,
      "filetypes": ["c", "cc", "cpp", "c++", "objc", "objcpp"],
      "rootPatterns": ["compile_flags.txt", "compile_commands.json"]
    },
    "efm": {
      "command": "/usr/bin/efm-langserver",
      "enable": false,
      "filetypes": ["bash", "lua", "racket", "sh", "vim"],
      "rootPatterns": [".git", "selene.toml", "vimrc", "init.vim"]
    },
    "gopls": {
      "command": "gopls",
      "enable": false,
      "filetypes": ["go"],
      "rootPatterns": ["go.mod"]
    },
    "ltex-ls-plus": {
      "command": "ltex-ls-plus",
      "enable": false,
      "filetypes": [
        "bib",
        "context",
        "gitcommit",
        "html",
        "latex",
        "mail",
        "markdown",
        "markdown.pandoc",
        "mdx",
        "org",
        "pandoc",
        "plaintex",
        "quarto",
        "rmd",
        "rnoweb",
        "rst",
        "tex",
        "text",
        "typst",
        "xhtml"
      ],
      "settings": {
        "ltex": {
          "disabledRules": {
            "en-US": ["MORFOLOGIK_RULE_EN_US"]
          },
          "language": "en-US"
        }
      }
    },
    "pylsp": {
      "command": "pylsp",
      "enable": false,
      "filetypes": ["python"],
      "rootPatterns": ["pyproject.toml", ".git"]
    },
    "racket-langserver": {
      "args": ["-l", "racket-langserver"],
      "command": "racket",
      "enable": false,
      "filetypes": ["racket"]
    },
    "ruff": {
      "args": ["server"],
      "command": "ruff",
      "filetypes": ["python"],
      "rootPatterns": ["pyproject.toml", "ruff.toml", ".ruff.toml", ".git"]
    },
    "stylua": {
      "args": ["--lsp"],
      "command": "stylua",
      "enable": false,
      "filetypes": ["lua"]
    },
    "taplo": {
      "args": ["lsp", "stdio"],
      "command": "taplo",
      "enable": false,
      "filetypes": ["toml"]
    },
    "texlab": {
      "command": "texlab",
      "enable": false,
      "filetypes": ["bib", "context", "latex", "plaintex", "tex"]
    }
  },
  "outline.sortBy": "position",
  "suggest.completionItemKindLabels": {
    "class": "",
    "color": "",
    "constant": "",
    "constructor": "",
    "enum": "",
    "enumMember": "",
    "event": "",
    "field": "",
    "file": "",
    "folder": "",
    "function": "",
    "interface": "",
    "keyword": "",
    "method": "",
    "module": "",
    "operator": "",
    "property": "",
    "reference": "",
    "snippet": "",
    "struct": "",
    "text": "",
    "typeParameter": "",
    "unit": "",
    "value": "",
    "variable": ""
  }
}
